{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ripenai-question-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "secrets": { "required": ["GROQ_API_KEY"] },
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "CF_FALLBACK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
